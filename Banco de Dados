-- selecionar todos de onde, utilizandos os filtros abaixo.
select * from Produto where modelo like ('%V%'); --like, trás trecho de palavras, onde o % é o caracter coringa.
select * from Produto where produto = 'camisa'; --usando o igual para pesquisar algo único com texto.
select * from Produto where id = 2; --usando o igual para pesquisar algo único com números.
select * from Produto where quantidade > 30; --usando o maior para pesquisar algo com quantidade superior ao número informado.

-- comando para atualizar valores na tabela, sempre utilizar a clausula where, pois sem ela, irá atualizar para todos os registros da tabela.
update produto set tamanho = 'M' where id = 2;

-- comando para deletar valores na tabela, sempre utilizar a clausula where, pois sem ela, irá atualizar para todos os registros da tabela.
DELETE produto where id = 2;
